{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.DunkelCloud/toolmesh",
  "description": "Self-hosted MCP gateway. Turn any REST API into MCP tools via YAML (DADL). Authz, audit, policies.",
  "repository": {
    "url": "https://github.com/DunkelCloud/ToolMesh",
    "source": "github"
  },
  "version": "0.4.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{host}:8123/mcp",
      "variables": {
        "host": {
          "description": "Hostname or IP of your ToolMesh instance",
          "isRequired": true,
          "format": "string",
          "placeholder": "toolmesh.example.com"
        }
      }
    }
  ]
}
