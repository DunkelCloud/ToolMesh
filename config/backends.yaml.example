# This file is parsed strictly: a key no backend field claims aborts startup
# with the offending line, rather than being ignored. A silently dropped
# "expose_tool" typo would otherwise read as an active restriction that is not
# actually in force.

backends:
  # MCP server over HTTP (Streamable HTTP or legacy SSE)
  # - name: my-service
  #   transport: http
  #   url: "https://my-service.example.com/mcp"
  #   api_key_env: "MY_SERVICE_API_KEY"
  #   # Operator guidance for THIS deployment: conventions to follow, a page to
  #   # read first, a local gotcha. It is delivered on the first tool call each
  #   # caller makes into this backend, so it arrives in full even when the
  #   # combined catalog blurb grows long enough for clients to truncate it.
  #   # Honored for every transport (rest, http, stdio).
  #   #
  #   # Say what the caller must DO, not what the backend is — the catalog line
  #   # already carries the description from the API definition, and repeating
  #   # it teaches nothing. Good: "Page names need a type prefix; read the
  #   # wiki_rules page before creating any page."
  #   hint: "What agents must know before using this backend"
  #   # Optional: restrict the surface to exactly these upstream tool names.
  #   # Everything else the MCP server offers disappears from discover_tools,
  #   # execute_code, and direct calls — useful when a server ships
  #   # housekeeping tools an agent has no business calling. Unlike the REST
  #   # path, entries are validated after the upstream tools/list, so a name
  #   # that matches nothing is reported in the log on connect.
  #   include_tools:
  #     - fetch_url
  #     - fetch_urls
  #   # Optional: promote selected tools to direct top-level MCP tools (in
  #   # addition to the always-available discover_tools / execute_code surface).
  #   # Use for high-frequency tools so the LLM can call them without a
  #   # discovery round-trip. The public MCP name is the bare tool name (e.g.
  #   # "web_search", "fetch_url"). When two backends would expose the same
  #   # bare name, both fall back to "<backend>_<tool>" automatically so the
  #   # surface stays unambiguous.
  #   #
  #   # Names reserved by upstream LLM clients (currently web_search,
  #   # code_interpreter, file_search, computer_use — OpenAI's built-in tool
  #   # types) are also auto-demoted to "<backend>_<tool>" form even when no
  #   # cross-backend conflict exists. Without this fallback ChatGPT's MCP
  #   # connector rejects the entire tools/list with "Invalid MCP tool schema".
  #   # The first demotion emits a WARN log so operators can see it kicked in.
  #   expose_tools:
  #     - web_search
  #     - fetch_url

  # MCP server over STDIO (local process)
  # - name: local-tools
  #   transport: stdio
  #   command: "./my-mcp-server"
  #   args: ["--port", "0"]

  # REST Proxy via DADL (no MCP server needed)
  # The hackernews DADL ships with ToolMesh and needs no credentials —
  # uncomment this block to try it out without any setup.
  # - name: hackernews
  #   transport: rest
  #   dadl: hackernews.dadl  # relative to TOOLMESH_DADL_DIR (default: /app/dadl), absolute paths also work
  #   options:
  #     blob_ttl: "1h"  # how long binary response URLs stay valid (default: 1h)
  #
  # For DADLs requiring credentials (download from https://dadl.ai/browse):
  # - name: vikunja
  #   transport: rest
  #   dadl: vikunja.dadl
  #   url: "https://vikunja.example.com/api/v1"  # overrides base_url in .dadl (optional)

  # REST Proxy targeting an internal service (private network, self-signed cert)
  # - name: internal-api
  #   transport: rest
  #   dadl: internal.dadl
  #   url: "https://192.168.1.50:8443/api"
  #   allow_private_url: true    # allow private/loopback base_url (default: true)
  #   tls_skip_verify: true      # accept self-signed or invalid TLS certificates (default: false)
  #   # Caller-supplied file_url parameters are fetched server-side. Their SSRF
  #   # policy is SEPARATE from allow_private_url (base_url is admin-trusted;
  #   # file_url values come from the tool caller) and defaults to fail-closed:
  #   allow_private_file_url: true            # allow file_url to resolve to private/loopback (default: false)
  #   file_url_allowed_hosts: ["blobstore.internal"]  # restrict file_url fetches to these hosts (recommended over the blanket flag)

  # OpenAI-compatible chat endpoint (Ollama, vLLM, LM Studio) sharing the broad
  # openai.dadl but exposing ONLY the chat/embeddings surface.
  # - name: ollama
  #   transport: rest
  #   dadl: openai.dadl
  #   url: "http://localhost:11434/v1"
  #   # include_tools restricts the exposed surface to exactly these names —
  #   # everything else in the DADL (images, audio, fine-tuning, vector stores)
  #   # disappears from discover_tools, execute_code, and direct calls. This
  #   # keeps the tool catalog small and stops the LLM picking an endpoint the
  #   # server does not implement. Omit it to expose every tool (the default).
  #   # Honored for every transport (rest, http, stdio).
  #   include_tools:
  #     - create_chat_completion
  #     - create_chat_completion_streaming
  #     - create_embedding
  #     - list_models
  #     - ask
  #   options:
  #     # Per-backend HTTP timeouts. timeout governs non-streaming calls;
  #     # streaming_timeout governs SSE (create_chat_completion_streaming).
  #     # A slow reasoning model needs a high streaming_timeout. ToolMesh keeps
  #     # the MCP client connection alive with SSE keepalives for the duration,
  #     # so long calls no longer trip "connector not responding".
  #     timeout: "180s"
  #     streaming_timeout: "15m"
