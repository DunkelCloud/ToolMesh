# This file is parsed strictly: a key no backend field claims aborts startup
# with the offending line, rather than being ignored. A silently dropped
# "expose_tool" typo would otherwise read as an active restriction that is not
# actually in force.

backends:
  # MCP server over HTTP (Streamable HTTP or legacy SSE)
  # - name: my-service
  #   transport: http
  #   url: "https://my-service.example.com/mcp"
  #   api_key_env: "MY_SERVICE_API_KEY"
  #   # Operator guidance for THIS deployment: conventions to follow, a page to
  #   # read first, a local gotcha. Honored for every transport (rest, http,
  #   # stdio).
  #   #
  #   # Say what the caller must DO, not what the backend is — the catalog line
  #   # already carries the description from the API definition, and repeating
  #   # it teaches nothing. Good: "Page names need a type prefix; read the
  #   # naming rules page before creating any page."
  #   hint: "What agents must know before using this backend"
  #   # Optional: make the hint a precondition. Without this line the hint is
  #   # advice, attached to the first call each user makes into the backend; a
  #   # second conversation of the same user does not get it. With it, a call
  #   # to a listed tool is refused until the caller shows that it has
  #   # received the hint. List access classes (read, write, admin,
  #   # dangerous), single tools by name (create_page), or "all" for every
  #   # tool. The refusal carries the hint and a "proofs" argument for
  #   # execute_code; a script is refused before it runs and is then run
  #   # again, unchanged, with that argument. The proof is valid for the day,
  #   # so every conversation gets the hint before its first such call. See
  #   # docs/configuration.md, "Backend hints".
  #   hint_required_for: [write, dangerous, admin]
  #   # Optional: restrict the surface to exactly these upstream tool names.
  #   # Everything else the MCP server offers disappears from discover_tools,
  #   # execute_code, and direct calls — useful when a server ships
  #   # housekeeping tools an agent has no business calling. Unlike the REST
  #   # path, entries are validated after the upstream tools/list, so a name
  #   # that matches nothing is reported in the log on connect.
  #   include_tools:
  #     - fetch_url
  #     - fetch_urls
  #   # Optional: promote selected tools to direct top-level MCP tools (in
  #   # addition to the always-available discover_tools / execute_code surface).
  #   # Use for high-frequency tools so the LLM can call them without a
  #   # discovery round-trip. The public MCP name is the bare tool name (e.g.
  #   # "web_search", "fetch_url"). When two backends would expose the same
  #   # bare name, both fall back to "<backend>_<tool>" automatically so the
  #   # surface stays unambiguous.
  #   #
  #   # Names reserved by upstream LLM clients (currently web_search,
  #   # code_interpreter, file_search, computer_use — OpenAI's built-in tool
  #   # types) are also auto-demoted to "<backend>_<tool>" form even when no
  #   # cross-backend conflict exists. Without this fallback ChatGPT's MCP
  #   # connector rejects the entire tools/list with "Invalid MCP tool schema".
  #   # The first demotion emits a WARN log so operators can see it kicked in.
  #   expose_tools:
  #     - web_search
  #     - fetch_url

  # MCP server over STDIO (local process)
  # - name: local-tools
  #   transport: stdio
  #   command: "./my-mcp-server"
  #   args: ["--port", "0"]
  #   # Optional: environment variables for the child from the credential
  #   # store (variable name in the child: key in the store). The child
  #   # inherits ToolMesh's environment; with CREDENTIAL_STORE=command that
  #   # holds no credentials, so these are the only ones it receives.
  #   credential_env:
  #     MY_SERVER_TOKEN: CREDENTIAL_MY_SERVER_TOKEN

  # Commands on hosts over SSH. The agent gets no shell: the command file
  # lists the commands as templates with typed parameters, and every call
  # runs one of them (see config/ssh/linux-host.yaml.example and
  # docs/configuration.md, "SSH backends").
  # - name: web
  #   transport: ssh
  #   commands: ssh/linux-host.yaml    # relative to this file's directory, absolute paths also work
  #   ssh:
  #     user: toolmesh                 # the account on the hosts
  #     # One host, or several: with several, every tool takes the parameter
  #     # "host". Write host or host:port.
  #     hosts: [web1.example.com]
  #     # The keys of the hosts, in OpenSSH known_hosts format. Required; a
  #     # host whose key is not in the file is not connected to.
  #     #   ssh-keyscan web1.example.com >> config/ssh/known_hosts
  #     # and compare the fingerprints with the host's own.
  #     known_hosts: ssh/known_hosts
  #     # The private key, from the credential store: CREDENTIAL_WEB_SSH_KEY.
  #     # In a .env line write \n for every line break, or the key in base64.
  #     key_credential: web_ssh_key
  #     # Or a key file instead:
  #     # key_file: ssh/id_ed25519
  #     # For a key under a passphrase: CREDENTIAL_WEB_SSH_KEY_PASSPHRASE.
  #     passphrase_credential: web_ssh_key_passphrase
  #   # hint, hint_required_for, include_tools and health_check work as for
  #   # the other transports. The health check connects to every host and
  #   # logs in, at startup, after a reload and every 15 minutes.

  # REST Proxy via DADL (no MCP server needed)
  # The hackernews DADL ships with ToolMesh and needs no credentials —
  # uncomment this block to try it out without any setup.
  # - name: hackernews
  #   transport: rest
  #   dadl: hackernews.dadl  # relative to TOOLMESH_DADL_DIR (default: /app/dadl), absolute paths also work
  #   options:
  #     blob_ttl: "1h"  # how long binary response URLs stay valid (default: 1h)
  #
  # For DADLs requiring credentials (download from https://dadl.ai/browse):
  # - name: vikunja
  #   transport: rest
  #   dadl: vikunja.dadl
  #   url: "https://vikunja.example.com/api/v1"  # overrides base_url in .dadl (optional)
  #   # The entry name sets the credentials this backend may read:
  #   # CREDENTIAL_VIKUNJA_* here, unless a longer entry name (vikunja-x)
  #   # owns part of it. A DADL that reads others, or sends them to a host
  #   # outside base_url's registrable domain, is refused at load until the
  #   # entry allows it explicitly. The refusal log names the lines, and
  #   # sets apart, with a warning, the ones that let the backend read a
  #   # variable other entries own or list, or send credentials further:
  #   # credentials: [vikunja_legacy_token]       # names outside the namespace
  #   # allowed_hosts: [files.vikunja-cdn.example, "*.cdn.example", media.example:8443]
  #   # A second entry on this DADL, named vikunja-staging, would read this
  #   # entry's vikunja_token. It gets a credential of its own instead:
  #   # env:
  #   #   CREDENTIAL_VIKUNJA_TOKEN: CREDENTIAL_VIKUNJA_STAGING_VIKUNJA_TOKEN
  #   # Optional: credentials that every user stores for themselves on the
  #   # page /credentials, instead of one value for all callers. A call then
  #   # authenticates as the calling user and fails, with a pointer to the
  #   # page, while that user has stored none; there is no fallback to
  #   # CREDENTIAL_<NAME>. Users can store several accounts and pick one per
  #   # call with the parameter "account". Needs TOOLMESH_USER_CREDENTIALS_KEY.
  #   # See docs/configuration.md, section "Credentials of Users".
  #   # Every listed name must be one the DADL's auth block reads.
  #   # user_credentials:
  #   #   - vikunja_token                # an item is the credential name ...
  #   # user_credentials:
  #   #   - name: vikunja_token          # ... or a mapping with the texts the page shows
  #   #     label: Vikunja API token
  #   #     hint: Create one under Settings, API tokens.
  #   # For an API whose session login takes a limit of the session, a user
  #   # can store one per account: a JSON object in the API's form, shown on
  #   # the page, enforced by the API. Without "optional" every account needs one.
  #   #   - name: mail_scope
  #   #     label: ACL
  #   #     format: acl
  #   #     optional: true
  #   # Optional, for DADLs that declare a health check: how ToolMesh monitors
  #   # it. Without this block the check runs at startup, after a reload and
  #   # every 15 minutes; failures show up on /health and in the metrics.
  #   # (Not for a backend with user_credentials: it is not monitored in the
  #   # background, where no user and so no credential exists.)
  #   health_check:
  #     interval: 1h               # poll hourly instead (minimum 30s, 0 turns polling off)
  #     degrade_after: 2           # consecutive failures before "degraded" (default: 1)
  #     warn_before: 7d            # warn this long before a known credential expiry (default: 7d)
  #     auth_expires_at: 2026-12-31  # credential expiry, when the API does not report it

  # REST Proxy targeting an internal service (private network, self-signed cert)
  # - name: internal-api
  #   transport: rest
  #   dadl: internal.dadl
  #   url: "https://192.168.1.50:8443/api"
  #   allow_private_url: true    # allow private/loopback base_url (default: true)
  #   tls_skip_verify: true      # accept self-signed or invalid TLS certificates (default: false)
  #   # Caller-supplied file_url parameters are fetched server-side. Their SSRF
  #   # policy is SEPARATE from allow_private_url (base_url is admin-trusted;
  #   # file_url values come from the tool caller) and defaults to fail-closed:
  #   allow_private_file_url: true            # allow file_url to resolve to private/loopback (default: false)
  #   file_url_allowed_hosts: ["blobstore.internal"]  # restrict file_url fetches to these hosts (recommended over the blanket flag)

  # OpenAI-compatible chat endpoint (Ollama, vLLM, LM Studio) sharing the broad
  # openai.dadl but exposing ONLY the chat/embeddings surface.
  # - name: ollama
  #   transport: rest
  #   dadl: openai.dadl
  #   url: "http://localhost:11434/v1"
  #   # include_tools restricts the exposed surface to exactly these names —
  #   # everything else in the DADL (images, audio, fine-tuning, vector stores)
  #   # disappears from discover_tools, execute_code, and direct calls. This
  #   # keeps the tool catalog small and stops the LLM picking an endpoint the
  #   # server does not implement. Omit it to expose every tool (the default).
  #   # Honored for every transport (rest, http, stdio).
  #   include_tools:
  #     - create_chat_completion
  #     - create_chat_completion_streaming
  #     - create_embedding
  #     - list_models
  #     - ask
  #   options:
  #     # Per-backend HTTP timeouts. timeout governs non-streaming calls;
  #     # streaming_timeout governs SSE (create_chat_completion_streaming).
  #     # A slow reasoning model needs a high streaming_timeout. ToolMesh keeps
  #     # the MCP client connection alive with SSE keepalives for the duration,
  #     # so long calls no longer trip "connector not responding".
  #     timeout: "180s"
  #     streaming_timeout: "15m"
